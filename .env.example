ELEVENLABS_API_KEY=

# Public GitHub sample packs cached into samples/libraries/ (gitignored) when Studio starts (WAV only, comma-separated).
# STUDIO_LIBRARY_DIR=samples/libraries
# Both defaults are openly licensed: TR-808 one-shots (CC0, ~12 MB) and breakbeat loops (Unlicense, ~2.5 MB).
STUDIO_LIBRARIES=https://github.com/tidalcycles/sounds-tr808-fischer,https://github.com/switchangel/breaks
# Optional: a GitHub token (read-only, public repos) raises the unauthenticated 60 requests/hour discovery limit.
# STUDIO_GITHUB_TOKEN=
# Optional: VCSL is CC0 but 5.9 GB in total, so point at one folder. TX81Z is 189 FM-synth WAVs (~128 MB).
# STUDIO_LIBRARIES=https://github.com/tidalcycles/sounds-tr808-fischer,https://github.com/switchangel/breaks,https://github.com/sgossner/VCSL/tree/master/Electrophones/TX81Z
