# The browser application does not require environment variables or provider keys.
# These settings are retained only for legacy filesystem tooling; they are never
# compiled into the browser. Packs are installed explicitly in Sample Catalogue.
ELEVENLABS_API_KEY=
STUDIO_LIBRARIES=
# STUDIO_LIBRARY_DIR=samples/libraries
