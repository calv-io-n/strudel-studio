// Afterglow · Atmosphere · open fifths · 174 BPM · A minor
// F-root open-fifth pad transposed to each chord root; gentle fades join phrases.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(174 / 4)

$: s(soundSlot("pad")).speed("<1.259921 .999999 .749154 1.122462>").slow(2).clip(1).attack(.8).release(.6).hpf(450).lpf(3500).gain(0.076).room(.3)
