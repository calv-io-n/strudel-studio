// Afterglow · Drums · second drop · 174 BPM · A minor
// Extra syncopation and tambourine lift the second drop.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(174 / 4)

$: stack(
  s(soundSlot("softkick")).struct("1 0 0 1 0 0 1 0").gain(0.656),
  s(soundSlot("softsnare")).struct("0 1 0 1").gain(0.576),
  s(soundSlot("softsnare")).struct("0 0 0 0 0 0 0 1").gain(0.088),
  s(soundSlot("hat")).struct("1 1 1 1 1 1 1 1").gain("0.176 0.088 0.152 0.096 0.176 0.08 0.16 0.104").pan(".42 .58"),
  s(soundSlot("openhat")).struct("0 0 1 0 0 0 1 0").gain(0.128).hpf(450),
  s(soundSlot("perc")).struct("0 0 0 1 0 0 0 1").gain(0.152).pan(.65)
).lastOf(8, p => p.struct("1 1 1 [1 1]")).postgain(.65)
$: s(soundSlot("tamb")).struct("0 1 0 1 0 1 0 1").gain(0.088).hpf(1800).pan(.3)
