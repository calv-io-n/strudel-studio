// Afterglow · FX · arrival · 174 BPM · A minor
// Crash and airy texture mark major arrivals.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(174 / 4)

$: s(soundSlot("crash")).struct("1 0 0 0").slow(4).gain(0.216).hpf(900).room(.25)
$: s(soundSlot("noise")).struct("1 0 0 0").slow(4).clip(.5).attack(.02).release(.6).gain(0.06).hpf(1500)
