// Neon Drive — Lead. An original four-bar phrase over Am / F / C / G.
// Knob 1 opens the lead's filter. Typed edits wait for Apply changes.
setCpm(168 / 4)

$lead: note("< [e5 ~ g5 a5 ~ e5 d5 c5] [c5 a4 c5 f5 ~ e5 c5 a4] [g4 c5 e5 ~ g5 e5 d5 ~] [b4 ~ d5 g5 f5 d5 b4 ~] >")
  .s("sawtooth")
  .lpf(slider(2400, 400, 6000, 50))
  .attack(0.008).decay(0.14).sustain(0.35).release(0.07)
  .gain(0.34).room(0.16)
  .delay(0.2).delaytime(0.267857).delayfeedback(0.22)

$chords: note("< [a3,c4,e4] [f3,a3,c4] [c3,e3,g3] [g3,b3,d4] >")
  .s("sawtooth").lpf(1200)
  .attack(0.04).decay(0.15).sustain(0.6).release(0.12)
  .gain(0.15).room(0.2)
