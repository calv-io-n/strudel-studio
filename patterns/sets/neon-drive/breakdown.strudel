// Neon Drive — Breakdown. Four quiet cycles before the final groove.
setCpm(168 / 4)

$pad: note("< [a3,c4,e4] [f3,a3,c4] [c3,e3,g3] [g3,b3,d4] >")
  .s("triangle").lpf(950)
  .attack(0.12).decay(0.2).sustain(0.55).release(0.2)
  .gain(0.23).room(0.3)

$arp: note("< [a4 ~ e5 ~] [f4 ~ c5 ~] [c4 ~ g4 ~] [g4 ~ d5 ~] >")
  .s("triangle").lpf(1800)
  .attack(0.005).decay(0.16).sustain(0).release(0.06)
  .gain(0.3).delay(0.23).delaytime(0.267857).delayfeedback(0.25)
