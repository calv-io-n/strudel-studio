// Skyline · Melody · distant · 174 BPM · B minor
// Original eight-bar lead motif. Sample root C3 is corrected for Studio’s C2 default.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(174 / 4)

$: note("<[f#5 ~ ~ e5 d5 ~ b4 ~] [d5 e5 f#5 ~ a5 f#5 e5 ~] [d5 ~ b4 d5 ~ g5 f#5 e5] [d5 b4 ~ a4 b4 d5 ~ ~] [a4 ~ d5 f#5 ~ e5 d5 ~] [f#5 a5 ~ f#5 e5 d5 e5 ~] [e5 ~ c#5 e5 a5 ~ g5 e5] [f#5 e5 c#5 ~ b4 ~ ~ ~]>").s(soundSlot("lead")).transpose(-12).clip(1).attack(.008).release(.18).hpf(350).lpf(2000).gain(0.072).room(.2).delay(.2).delaytime(0.258621).delayfeedback(.28)
$: note("<[f#5 ~ ~ e5 d5 ~ b4 ~] [d5 e5 f#5 ~ a5 f#5 e5 ~] [d5 ~ b4 d5 ~ g5 f#5 e5] [d5 b4 ~ a4 b4 d5 ~ ~] [a4 ~ d5 f#5 ~ e5 d5 ~] [f#5 a5 ~ f#5 e5 d5 e5 ~] [e5 ~ c#5 e5 a5 ~ g5 e5] [f#5 e5 c#5 ~ b4 ~ ~ ~]>").s("sawtooth").attack(.014).decay(.11).sustain(.28).release(.16).hpf(500).lpf(4300).gain(0.016).pan(.62).room(.17)
