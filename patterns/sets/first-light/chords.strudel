  s(soundSlot("minor")).struct("1 0 0 0").speed(0.8408964153).clip(1).attack(.02).release(.3).gain(0.184).hpf(240).lpf(5500),
  s(soundSlot("dmajor")).struct("0 1 0 0").speed(1).clip(1).attack(.02).release(.3).gain(0.184).hpf(240).lpf(5500),
  s(soundSlot("amajor")).struct("0 0 1 0").speed(1).clip(1).attack(.02).release(.3).gain(0.184).hpf(240).lpf(5500),
