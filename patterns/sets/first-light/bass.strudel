// First Light · Bass · texture · 174 BPM · F# minor
// Recorded C2 bass: sampler default root is C2, so note values transpose correctly.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(174 / 4)

$: note("<f#1 f#1 d2 d2 a1 a1 e2 e2>").s(soundSlot("reese")).struct("1 0 1 0 0 1 1 0").clip(1).attack(.012).release(.08).hpf(160).lpf(1800).gain(0.24)
