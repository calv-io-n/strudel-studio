setCpm(172 / 4)

$: note("<[d5 ~ f5 ~ a5 g5 f5 ~] [e5 f5 d5 ~ c5 d5 ~ ~] [c5 ~ a4 c5 f5 ~ g5 a5] [g5 f5 e5 ~ c5 ~ a4 ~] [g4 ~ c5 e5 ~ g5 a5 g5] [e5 d5 c5 ~ e5 g5 ~ ~] [f5 ~ e5 d5 a4 ~ c5 d5] [e5 f5 a5 ~ g5 f5 d5 ~]>").s(soundSlot("pluck")).transpose(-12).clip(1).attack(.008).release(.18).hpf(350).lpf(5600).gain(0.3).room(.2).delay(.2).delaytime(0.261628).delayfeedback(.28)
