// Solar Tide · Bass · texture · 172 BPM · D minor
// Recorded C2 bass layer supplies upper harmonics, above the separate sine sub.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(172 / 4)

$: note("<bb1 bb1 f1 f1 c2 c2 d2 d2>").s(soundSlot("reese")).struct("1 0 0 1 0 1 0 1").clip(1).attack(.012).release(.08).hpf(170).lpf(1400).gain(.24)
