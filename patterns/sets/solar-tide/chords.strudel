// Solar Tide · Chords · full · 172 BPM · D minor
// Two bars per chord. Sampled major/minor chord hits are transposed to the written progression.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(172 / 4)

$: note("<[bb3,d4,f4,a4] [bb3,d4,f4,a4] [f3,a3,c4,g4] [f3,a3,c4,g4] [c4,e4,g4,d5] [c4,e4,g4,d5] [d3,f3,a3,c4] [d3,f3,a3,c4]>").s("triangle").attack(.07).release(.4).gain(0.09).lpf(2700).room(.22)
$: stack(
  s(soundSlot("amajor")).struct("1 0 0 0").speed(1.059463094).clip(1).attack(.03).release(.35).gain(0.17).hpf(280).lpf(5000),
  s(soundSlot("dmajor")).struct("0 1 0 0").speed(1.189207115).clip(1).attack(.03).release(.35).gain(0.17).hpf(280).lpf(5000),
  s(soundSlot("emajor")).struct("0 0 1 0").speed(0.793700526).clip(1).attack(.03).release(.35).gain(0.17).hpf(280).lpf(5000),
  s(soundSlot("minor")).struct("0 0 0 1").speed(1.334839854).clip(1).attack(.03).release(.35).gain(0.17).hpf(280).lpf(5000)
).slow(8)
