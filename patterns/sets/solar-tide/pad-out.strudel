// Solar Tide · Atmosphere · dissolve · 172 BPM · D minor
// Open-fifth pad tuned from F to each chord root; two-bar fades keep the texture smooth.
// One cycle = one 4/4 bar. Sample slots are installed with this session.
setCpm(172 / 4)

$: s(soundSlot("pad")).speed("<1.33483985 1.00000000 0.74915354 0.84089642>").slow(2).clip(1).attack(.8).release(.6).hpf(500).lpf(3000).gain("<.07 .05 .03 .01>").room(.28)
