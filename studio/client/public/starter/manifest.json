      "version": 5,
      "tabs": [
        {
          "id": "neon-rhythm",
          "name": "Rhythm",
          "code": "// Neon Drive — Rhythm. Original synth-pop demo, 168 BPM / 4 beats per cycle.\n// Knob 2 controls the bass cutoff, even while another tab is selected.\nsetCpm(168 / 4)\n\n$kick: s(\"sbd*4\")\n  .decay(0.16).gain(0.62)\n\n// Noise snare, with a sixteenth-note pickup at the end of every fourth bar.\n$snare: s(\"< [~ white ~ white] [~ white ~ white] [~ white ~ white] [~ white ~ [white ~ white white]] >\")\n  .hpf(1300).lpf(8500)\n  .attack(0.001).decay(0.12).sustain(0).release(0.02)\n  .gain(0.42).room(0.12)\n\n$hat: s(\"white*8\")\n  .hpf(7500).lpf(12000)\n  .attack(0.001).decay(0.025).sustain(0).release(0.01)\n  .gain(\"0.11 0.18 0.11 0.18 0.11 0.18 0.11 0.21\")\n\n$bass: note(\"< [a1 a2 a1 a2 a1 a2 a1 e2] [f1 f2 f1 f2 f1 f2 f1 c2] [c2 c3 c2 c3 c2 c3 c2 g2] [g1 g2 g1 g2 g1 g2 d2 g2] >\")\n  .s(\"sawtooth\")\n  .lpf(slider(900, 200, 2400, 25))\n  .attack(0.004).decay(0.11).sustain(0.1).release(0.03)\n  .gain(\"0.32 0.46 0.32 0.46 0.32 0.46 0.32 0.46\")\n",
          "anchors": [
            {
              "id": "neon-rhythm-slider-0",
              "from": 801,
              "fingerprint": "slider(200,2400,25)"
            }
          ],
          "color": "blue"
        },
        {
          "id": "neon-chords",
          "name": "Chords",
          "code": "// Neon Drive — Chords. The four-cycle opening: Am / F / C / G.\n// Play this tab alone to hear the harmony before the rhythm arrives.\nsetCpm(168 / 4)\n\n$chords: note(\"< [a3,c4,e4] [f3,a3,c4] [c3,e3,g3] [g3,b3,d4] >\")\n  .s(\"sawtooth\").lpf(1500)\n  .attack(0.09).decay(0.2).sustain(0.65).release(0.15)\n  .gain(0.23).room(0.22)\n\n$spark: note(\"<e5 c5 g4 d5>\")\n  .s(\"triangle\")\n  .attack(0.005).decay(0.3).sustain(0).release(0.1)\n  .gain(0.25).delay(0.18).delaytime(0.267857).delayfeedback(0.2)\n",
          "anchors": [],
          "color": "cyan"
        },
        {
          "id": "neon-lead",
          "name": "Lead",
          "code": "// Neon Drive — Lead. An original four-bar phrase over Am / F / C / G.\n// Knob 1 opens the lead's filter. Typed edits wait for Apply changes.\nsetCpm(168 / 4)\n\n$lead: note(\"< [e5 ~ g5 a5 ~ e5 d5 c5] [c5 a4 c5 f5 ~ e5 c5 a4] [g4 c5 e5 ~ g5 e5 d5 ~] [b4 ~ d5 g5 f5 d5 b4 ~] >\")\n  .s(\"sawtooth\")\n  .lpf(slider(2400, 400, 6000, 50))\n  .attack(0.008).decay(0.14).sustain(0.35).release(0.07)\n  .gain(0.34).room(0.16)\n  .delay(0.2).delaytime(0.267857).delayfeedback(0.22)\n\n$chords: note(\"< [a3,c4,e4] [f3,a3,c4] [c3,e3,g3] [g3,b3,d4] >\")\n  .s(\"sawtooth\").lpf(1200)\n  .attack(0.04).decay(0.15).sustain(0.6).release(0.12)\n  .gain(0.15).room(0.2)\n",
          "anchors": [
            {
              "id": "neon-lead-slider-0",
              "from": 306,
              "fingerprint": "slider(400,6000,50)"
            }
          ],
          "color": "teal"
        },
        {
          "id": "neon-breakdown",
          "name": "Breakdown",
          "code": "// Neon Drive — Breakdown. Four quiet cycles before the final groove.\nsetCpm(168 / 4)\n\n$pad: note(\"< [a3,c4,e4] [f3,a3,c4] [c3,e3,g3] [g3,b3,d4] >\")\n  .s(\"triangle\").lpf(950)\n  .attack(0.12).decay(0.2).sustain(0.55).release(0.2)\n  .gain(0.23).room(0.3)\n\n$arp: note(\"< [a4 ~ e5 ~] [f4 ~ c5 ~] [c4 ~ g4 ~] [g4 ~ d5 ~] >\")\n  .s(\"triangle\").lpf(1800)\n  .attack(0.005).decay(0.16).sustain(0).release(0.06)\n  .gain(0.3).delay(0.23).delaytime(0.267857).delayfeedback(0.25)\n",
          "anchors": [],
          "color": "green"
        }
      ],
