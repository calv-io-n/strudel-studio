{
  "name": "strudel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first workspace for writing Strudel patterns, arranging music, and performing with MIDI.",
  "scripts": {
    "patch-strudel-server": "node ./scripts/patch-strudel-server.mjs",
    "ensure-deps": "node ./scripts/ensure-deps.mjs",
    "sampler": "PORT=5555 npx @strudel/sampler --dir ./samples",
    "watch": "bun node_modules/strudel-server/src/main.ts patterns/scratch.strudel",
    "dev": "npm run studio",
    "reload": "node ./scripts/reload.mjs",
    "save": "node ./scripts/save.mjs",
    "load": "node ./scripts/load.mjs",
    "rec": "./scripts/rec.sh",
    "chop": "./scripts/chop.sh",
    "trim": "./scripts/trim.sh",
    "norm": "./scripts/norm.sh",
    "yt": "./scripts/yt.sh",
    "studio": "concurrently -k -n samples,studio -c blue,yellow \"npm run sampler\" \"npm run studio:app\"",
    "studio:build": "tsc --noEmit && vite build --config studio/vite.config.ts",
    "studio:test": "tsx --test studio/tests/*.test.ts",
    "studio:e2e": "playwright test --config studio/playwright.config.ts",
    "studio:app": "tsx studio/server/index.ts",
    "dev:watcher": "concurrently -n sam,watch -c blue,green \"npm run sampler\" \"npm run watch\"",
    "studio:demo": "tsx studio/server/demo.ts",
    "setup:watcher": "node scripts/setup-watcher.mjs",
    "setup:browser-tests": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "agent-browser": "^0.36.0",
    "concurrently": "^9.2.4",
    "strudel-server": "git+https://github.com/micahkepe/strudel-server.git#b7b4e5742a54ffda7781bd0d1ef33d6a0588c73e",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/javascript": "^1.5.4",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/sampler": "^0.2.4",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "fflate": "^0.8.3",
    "ws": "^8.21.3",
    "zod": "4.5.4"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/calv-io-n/strudel.git"
  },
  "homepage": "https://github.com/calv-io-n/strudel#readme",
  "bugs": {
    "url": "https://github.com/calv-io-n/strudel/issues"
  }
}
