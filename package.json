{
  "name": "strudel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-first music workspace for Strudel, ready for static hosting.",
  "scripts": {
    "dev": "vite --config studio/vite.config.ts",
    "studio": "npm run dev",
    "studio:build": "npm run studio:starters && tsc --noEmit && vite build --config studio/vite.config.ts",
    "studio:test": "tsx --test studio/tests/*.test.ts",
    "studio:e2e": "playwright test --config studio/playwright.config.ts",
    "studio:app": "npm run dev",
    "studio:demo": "npm run studio:starters",
    "setup:browser-tests": "playwright install chromium",
    "studio:docs": "node scripts/build-strudel-docs.mjs",
    "studio:preview": "vite preview --config studio/vite.config.ts",
    "studio:starters": "node --import tsx scripts/build-starters.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "acorn": "^8.18.0",
    "agent-browser": "^0.36.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/javascript": "^1.5.4",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "fflate": "^0.8.3",
    "zod": "4.5.4"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/calv-io-n/strudel.git"
  },
  "homepage": "https://github.com/calv-io-n/strudel#readme",
  "bugs": {
    "url": "https://github.com/calv-io-n/strudel/issues"
  }
}
